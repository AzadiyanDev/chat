# =========================
# Repository-wide ignore rules
# =========================

# Build/publish outputs
publish/
publish-ready/
**/bin/
**/obj/
**/[Dd]ebug/
**/[Rr]elease/
**/out/
**/artifacts/
**/TestResults/

# Frontend build/cache
**/node_modules/
**/dist/
**/.angular/
**/.cache/
**/.parcel-cache/
**/.sass-cache/
**/.turbo/
**/.eslintcache
**/*.tsbuildinfo
**/coverage/
**/tmp/
**/temp/

# Logs
*.log
*.pid
*.seed
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE/editor
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# .NET / NuGet
*.rsuser
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
.nuget/
packages/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment/local secret files
.env
.env.*
!.env.example
*.local
