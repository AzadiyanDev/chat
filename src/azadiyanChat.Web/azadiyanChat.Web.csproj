<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\azadiyanChat.Application\azadiyanChat.Application.csproj" />
    <ProjectReference Include="..\azadiyanChat.Infrastructure\azadiyanChat.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <BuildClientAppOnPublish>true</BuildClientAppOnPublish>
  </PropertyGroup>

  <Target Name="BuildClientAppForPublish"
          BeforeTargets="PrepareForPublish"
          Condition="'$(BuildClientAppOnPublish)' == 'true' and Exists('$(SpaRoot)package.json')">
    <Message Importance="high" Text="Building ClientApp for publish..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <Target Name="IncludeBuiltClientAppDistFiles"
          BeforeTargets="ComputeFilesToPublish"
          Condition="'$(BuildClientAppOnPublish)' == 'true' and Exists('$(SpaRoot)dist')">
    <ItemGroup>
      <ClientAppDistFiles Include="$(SpaRoot)dist\**\*"
                          Exclude="$(SpaRoot)dist\**\*.map;$(SpaRoot)dist\**\*.json" />
      <ResolvedFileToPublish Include="@(ClientAppDistFiles)">
        <RelativePath>%(ClientAppDistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
